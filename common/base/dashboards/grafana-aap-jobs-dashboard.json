                                        "url": "/d/${__dashboard.uid}/${__dashboard}?${organization:queryparam}&${project:queryparam}&${job_status:queryparam}&${job_template:queryparam}&var-job_id=${__value.raw}&var-host_name=All"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Status"
                        },
                        "properties": [
                            {
                                "id": "mappings",
                                "value": [
                                    {
                                        "type": "value",
                                        "options": {
                                            "successful": {
                                                "color": "green",
                                                "index": 0,
                                                "text": "successful"
                                            },
                                            "failed": {
                                                "color": "red",
                                                "index": 1,
                                                "text": "failed"
                                            },
                                            "error": {
                                                "color": "red",
                                                "index": 2,
                                                "text": "error"
                                            },
                                            "canceled": {
                                                "color": "orange",
                                                "index": 3,
                                                "text": "canceled"
                                            },
                                            "running": {
                                                "color": "blue",
                                                "index": 4,
                                                "text": "running"
                                            },
                                            "pending": {
                                                "color": "yellow",
                                                "index": 5,
                                                "text": "pending"
                                            },
                                            "waiting": {
                                                "color": "yellow",
                                                "index": 6,
                                                "text": "waiting"
                                            }
                                        }
                                    }
                                ]
                            },
                            {
                                "id": "custom.cellOptions",
                                "value": {
                                    "type": "color-text"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Failed"
                        },
                        "properties": [
                            {
                                "id": "mappings",
                                "value": [
                                    {
                                        "type": "value",
                                        "options": {
                                            "true": {
                                                "color": "red",
                                                "index": 0,
                                                "text": "true"
                                            },
                                            "false": {
                                                "color": "green",
                                                "index": 1,
                                                "text": "false"
                                            }
                                        }
                                    }
                                ]
                            },
                            {
                                "id": "custom.cellOptions",
                                "value": {
                                    "type": "color-text"
                                }
                            }
