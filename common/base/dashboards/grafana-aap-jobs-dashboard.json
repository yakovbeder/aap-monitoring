                    "rawSql": "SELECT\n  host_name,\n  ok,\n  changed,\n  failures,\n  dark AS unreachable,\n  skipped,\n  processed,\n  failed\nFROM main_jobhostsummary\nWHERE ${job_id} <> 0\n  AND job_id = ${job_id}\nORDER BY failures DESC, dark DESC, host_name;",
