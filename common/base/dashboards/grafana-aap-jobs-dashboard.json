                    "rawSql": "SELECT\n  host_name,\n  task,\n  event,\n  COALESCE(\n    NULLIF(event_data::jsonb->>'msg', ''),\n    NULLIF(event_data::jsonb#>>'{res,msg}', ''),\n    LEFT(regexp_replace(COALESCE(stdout, ''), E'\\\\x1b\\\\[[0-9;]*m', '', 'g'), 500)\n  ) AS failed_message\nFROM main_jobevent\nWHERE ${job_id} <> 0\n  AND job_id = ${job_id}\n  AND failed = true\n  AND event IN ('runner_on_failed', 'runner_item_on_failed', 'runner_on_unreachable', 'runner_on_async_failed')\n  AND '${host_name}' <> '__none__'\n  AND (\n    '${host_name}' = '.*'\n    OR host_name = '${host_name}'\n  )\nORDER BY counter\nLIMIT 200;",
