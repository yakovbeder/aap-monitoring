            },
            "gridPos": {
                "h": 10,
                "w": 24,
                "x": 0,
                "y": 7
            },
            "id": 2,
            "options": {
                "cellHeight": "sm",
                "footer": {
                    "countRows": false,
                    "fields": "",
                    "reducer": [
                        "sum"
                    ],
                    "show": false
                },
                "showHeader": true,
                "sortBy": [
                    {
                        "desc": true,
                        "displayName": "Started"
                    }
                ]
            },
            "targets": [
                {
                    "datasource": {
                        "type": "grafana-postgresql-datasource",
                        "uid": "aap-postgres"
                    },
                    "editorMode": "code",
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT\n  uj.id AS \"Job ID\",\n  uj.name AS \"Job Name\",\n  COALESCE(o.name, o_ujt.name) AS \"Organization\",\n  pu.name AS \"Project\",\n  ujt.name AS \"Template\",\n  uj.status AS \"Status\",\n  uj.failed AS \"Failed\",\n  uj.launch_type AS \"Launch Type\",\n  COUNT(jhs.id) AS \"Hosts\",\n  uj.started AS \"Started\",\n  uj.finished AS \"Finished\"\nFROM main_unifiedjob uj\nLEFT JOIN main_organization o ON uj.organization_id = o.id\nLEFT JOIN main_unifiedjobtemplate ujt ON uj.unified_job_template_id = ujt.id\nLEFT JOIN main_organization o_ujt ON ujt.organization_id = o_ujt.id\nLEFT JOIN main_jobtemplate jt ON jt.unifiedjobtemplate_ptr_id = ujt.id\nLEFT JOIN main_unifiedjobtemplate pu ON jt.project_id = pu.id\nLEFT JOIN main_jobhostsummary jhs ON jhs.job_id = uj.id\nWHERE uj.status IN (${job_status:sqlstring})\n  AND (\n      ${organization} = -1\n      OR COALESCE(uj.organization_id, ujt.organization_id) IN (${organization})\n    )\n  AND (\n      ${project} = -1\n      OR jt.project_id IN (${project})\n    )\n  AND (\n    ${job_template} = -1\n    OR uj.unified_job_template_id IN (${job_template})\n  )\nGROUP BY uj.id, uj.name, o.name, o_ujt.name, pu.name, ujt.name, uj.status, uj.failed, uj.launch_type, uj.started, uj.finished\nORDER BY uj.started DESC NULLS LAST\nLIMIT 200;",
                    "refId": "A"
                }
            ],
            "title": "Jobs",
            "type": "table"
        },
